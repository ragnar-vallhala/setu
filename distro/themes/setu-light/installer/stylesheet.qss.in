/* SPDX-License-Identifier: MIT OR Apache-2.0
 * Setu's look for Calamares (the installer and the first-boot wizard),
 * a template filled from the default pack's tokens by
 * distro/themes/render-packs.py (template syntax: distro/themes/themelib.py
 * fill(); Derived tokens are computed there): flat controls with
 * 4 px corners, the accent for the default button, focus and selection.
 * Calamares applies stylesheet.qss from the branding directory to its
 * whole window. */

/* (the sidebar takes its colours from branding.desc) */
QWidget {
    font-family: "@Fonts.ui|face@";
    font-size: 10pt;
    color: @text@;
}
QMainWindow, QDialog {
    background-color: @window-bg@;
}

/* The sidebar (object names from Calamares' CalamaresWindow): all of it in
 * the taskbar colour, like its step list (branding.desc), and a flat About
 * button. */
#sidebarApp, #logoApp {
    background-color: @Installer.sidebar@;
}
#sidebarApp QPushButton, #aboutButton {
    background-color: transparent;
    border: none;
    color: @text-secondary@;
}
#sidebarApp QPushButton:hover, #aboutButton:hover { background-color: @Derived.sidebar-hover@; }
/* the step list: no white list-view box (the QListView rule below) */
#sidebarApp QListView {
    background-color: transparent;
    border: none;
}

/* Next / Install / Done: the primary action in the accent */
#view-button-next {
    background-color: @accent@;
    border-color: @accent@;
    color: @accent-text@;
}
#view-button-next:hover { background-color: @accent-hover@; }
#view-button-next:pressed { background-color: @accent-pressed@; }
#view-button-next:disabled {
    background-color: @window-bg@;
    border-color: @border-subtle@;
    color: @text-disabled@;
}

QPushButton {
    background-color: @surface@;
    border: 1px solid @border@;
    border-radius: 4px;
    padding: 5px 18px;
    min-height: 18px;
    min-width: 64px;
}
QPushButton:hover { background-color: @surface-hover@; }
QPushButton:pressed { background-color: @Derived.surface-pressed@; }
QPushButton:focus { border: 2px solid @accent@; }
QPushButton:default {
    background-color: @accent@;
    border-color: @accent@;
    color: @accent-text@;
}
QPushButton:default:hover { background-color: @accent-hover@; }
QPushButton:default:pressed { background-color: @accent-pressed@; }
QPushButton:disabled {
    background-color: @window-bg@;
    border-color: @border-subtle@;
    color: @text-disabled@;
}

QLineEdit, QSpinBox {
    background-color: @surface@;
    border: 1px solid @border@;
    border-radius: 4px;
    padding: 4px 8px;
    min-height: 20px;
    selection-background-color: @accent@;
    selection-color: @accent-text@;
}
QLineEdit:focus, QSpinBox:focus { border-bottom: 2px solid @accent@; }
QLineEdit:disabled { color: @text-disabled@; background-color: @window-bg@; }

QComboBox {
    background-color: @surface@;
    border: 1px solid @border@;
    border-radius: 4px;
    padding: 4px 8px;
    min-height: 20px;
}
QComboBox:focus { border-bottom: 2px solid @accent@; }
QComboBox:hover { background-color: @Derived.surface-alt@; }
QComboBox QAbstractItemView {
    background-color: @surface@;
    border: 1px solid @border@;
    selection-background-color: @surface-hover@;
    selection-color: @text@;
    outline: none;
}

QListView, QTreeView, QTableView {
    background-color: @surface@;
    alternate-background-color: @Derived.surface-alt@;
    border: 1px solid @border-subtle@;
    border-radius: 4px;
    selection-background-color: @Derived.selection-solid@;
    selection-color: @text@;
    outline: none;
}
QListView::item, QTreeView::item { min-height: 28px; }
QListView::item:hover, QTreeView::item:hover { background-color: @surface-hover@; }
QListView::item:selected, QTreeView::item:selected {
    background-color: @Derived.selection-solid@;
    color: @text@;
}
QHeaderView::section {
    background-color: @window-bg@;
    border: none;
    border-bottom: 1px solid @border-subtle@;
    padding: 4px 8px;
}

QGroupBox {
    border: 1px solid @border-subtle@;
    border-radius: 8px;
    margin-top: 12px;
    padding-top: 8px;
    background-color: @surface@;
}
QGroupBox::title {
    subcontrol-origin: margin;
    left: 12px;
    padding: 0 4px;
    color: @text-secondary@;
}

/* Install progress: a thin accent bar (DESIGN.md progress bar); the step
 * text is Calamares' own label above it. */
QProgressBar {
    background-color: @border-subtle@;
    border: none;
    border-radius: 3px;
    max-height: 6px;
    min-height: 6px;
    color: transparent;
}
QProgressBar::chunk {
    background-color: @accent@;
    border-radius: 3px;
}

QScrollBar:vertical {
    background: transparent;
    width: 10px;
    margin: 0;
}
QScrollBar::handle:vertical {
    background: @Derived.scrollbar@;
    border-radius: 4px;
    min-height: 32px;
    margin: 2px;
}
QScrollBar::handle:vertical:hover { background: @Derived.scrollbar-hover@; }
QScrollBar::add-line, QScrollBar::sub-line { height: 0; width: 0; }
QScrollBar::add-page, QScrollBar::sub-page { background: transparent; }

QToolTip {
    background-color: @surface@;
    border: 1px solid @border@;
    border-radius: 4px;
    color: @text@;
    padding: 4px;
}
