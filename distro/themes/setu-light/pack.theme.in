; Setu theme pack @Theme.Id@ (docs/THEMES.md), generated by
; distro/themes/render-packs.py from the pack's theme.ini. Format:
; https://learn.microsoft.com/en-us/windows/win32/controls/themesfileformat-overview
[Theme]
DisplayName=@Theme.Name@

[Control Panel\Desktop]
Wallpaper=@Wallpaper.path@
WallpaperStyle=@Wallpaper.style@
TileWallpaper=0

[VisualStyles]
Path=%WinDir%\Resources\Themes\@Theme.Id@\visual\@Theme.Id@.msstyles
ColorStyle=NormalColor
Size=NormalSize

@@COLORS@@

@@CURSORS@@

@@SOUNDS@@

[MasterThemeSelector]
MTSM=RJSPBS

[Setu]
Tokens=theme.ini
Icons=icons\index.ini
IconSet=@Icons.set@
Mode=@Theme.Mode@
