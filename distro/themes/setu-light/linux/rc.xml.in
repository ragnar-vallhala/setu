<?xml version="1.0"?>
<!--
  labwc configuration for the Setu session. labwc only hosts the personality's
  desktop window (fullscreen, see setu-session); the Setu shell is the
  desktop UI. So: no server-side decorations, and no compositor key bindings
  (labwc's defaults, e.g. Alt+F4 or Super for its menu, would act on the whole
  desktop window instead of reaching Windows programs). Defining one keybind
  replaces labwc's default set.
  Generated from the active theme pack (/usr/lib/setu/setu-theme-linux):
  labwc's built-in theme with the pack's colours (themerc-override), fonts
  and window corner radius; cursors: environment.
-->
<labwc_config>
  <core>
    <decoration>client</decoration>
    <gap>0</gap>
  </core>
  <theme>
    <cornerRadius>@Metrics.radius-window@</cornerRadius>
    <font place="ActiveWindow"><name>@Fonts.ui|face@</name><size>@Fonts.title-size|int@</size><weight>@Fonts.caption-weight|weight@</weight></font>
    <font place="InactiveWindow"><name>@Fonts.ui|face@</name><size>@Fonts.title-size|int@</size><weight>@Fonts.caption-weight|weight@</weight></font>
    <font place="MenuHeader"><name>@Fonts.ui|face@</name><size>@Fonts.title-size|int@</size><weight>@Fonts.caption-weight|weight@</weight></font>
    <font place="MenuItem"><name>@Fonts.ui|face@</name><size>@Fonts.title-size|int@</size></font>
    <font place="OnScreenDisplay"><name>@Fonts.ui|face@</name><size>@Fonts.title-size|int@</size></font>
  </theme>
  <keyboard>
    <keybind key="W-A-S-F12">
      <action name="None" />
    </keybind>
  </keyboard>
  <windowRules>
    <windowRule identifier="*" serverDecoration="no" />
  </windowRules>
</labwc_config>
