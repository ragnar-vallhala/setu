# Packages installed into the Setu dev image (Debian stable, mmdebstrap
# --variant=minbase). One per line; '#' starts a comment.

# Base system and boot
systemd
systemd-sysv
systemd-resolved
libpam-systemd
dbus
udev
linux-image-amd64
grub-efi-amd64
initramfs-tools
e2fsprogs
attr  # getfattr/setfattr: NT security descriptors are xattrs (services/fs, distro/tests/ntacl-smoke.sh)
kmod
sudo
openssh-server
ca-certificates
less
procps
iproute2

# Wayland session: compositor + Xwayland
labwc
xwayland
foot
mesa-utils-bin
libgl1-mesa-dri
fonts-dejavu-core

# Setu's look (docs/DESIGN.md): fonts, cursors, boot splash. NOTICE §5.
fontconfig            # fc-cache, fc-match; the personality enumerates fonts through libfontconfig
fonts-inter           # the UI font (OFL-1.1); wine.inf maps the Windows UI face names to "Inter"
fonts-jetbrains-mono  # the monospace font (OFL-1.1); substituted for Courier New/Consolas
adwaita-icon-theme    # fallback X cursors for names the Setu cursor sets (art/cursors) do not draw
plymouth              # the boot splash (one script theme per theme pack, distro/themes)

# Runtime libraries the Setu personality (Wine) loads directly or by dlopen
libfreetype6
libfontconfig1
libx11-6
libx11-xcb1
libxext6
libxrender1
libxrandr2
libxi6
libxcursor1
libxinerama1
libxcomposite1
libxfixes3
libxxf86vm1
libxkbcommon0
libxkbregistry0
libwayland-client0
libgl1
libegl1
libvulkan1
libgnutls30t64
libdbus-1-3
libunwind8
libasound2t64
libpulse0
libgstreamer1.0-0
libgstreamer-plugins-base1.0-0
ocl-icd-libopencl1
