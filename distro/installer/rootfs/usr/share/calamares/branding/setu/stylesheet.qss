/* SPDX-License-Identifier: MIT OR Apache-2.0
 * Setu's look for Calamares (the installer and the first-boot wizard):
 * docs/DESIGN.md colours, Inter, flat controls with 4 px corners, the
 * accent for the default button, focus and selection. Calamares applies
 * stylesheet.qss from the branding directory to its whole window. */

/* (no colour here: the sidebar takes its colours from branding.desc) */
QWidget {
    font-family: "Inter";
    font-size: 10pt;
}
QMainWindow, QDialog {
    background-color: #F3F3F3;
}

/* The sidebar (object names from Calamares' CalamaresWindow): all of it in
 * the taskbar colour, like its step list (branding.desc), and a flat About
 * button. */
#sidebarApp, #logoApp {
    background-color: #EEF1F5;
}
#sidebarApp QPushButton, #aboutButton {
    background-color: transparent;
    border: none;
    color: #5F5F5F;
}
#sidebarApp QPushButton:hover, #aboutButton:hover { background-color: #E2E6EC; }
/* the step list: no white list-view box (the QListView rule below) */
#sidebarApp QListView {
    background-color: transparent;
    border: none;
}

/* Next / Install / Done: the primary action in the accent */
#view-button-next {
    background-color: #1F6FB2;
    border-color: #1F6FB2;
    color: #FFFFFF;
}
#view-button-next:hover { background-color: #2A7DC3; }
#view-button-next:pressed { background-color: #195E97; }
#view-button-next:disabled {
    background-color: #F3F3F3;
    border-color: #E5E5E5;
    color: #A0A0A0;
}

QPushButton {
    background-color: #FFFFFF;
    border: 1px solid #D1D1D1;
    border-radius: 4px;
    padding: 5px 18px;
    min-height: 18px;
    min-width: 64px;
}
QPushButton:hover { background-color: #EAEAEA; }
QPushButton:pressed { background-color: #E0E0E0; }
QPushButton:focus { border: 2px solid #1F6FB2; }
QPushButton:default {
    background-color: #1F6FB2;
    border-color: #1F6FB2;
    color: #FFFFFF;
}
QPushButton:default:hover { background-color: #2A7DC3; }
QPushButton:default:pressed { background-color: #195E97; }
QPushButton:disabled {
    background-color: #F3F3F3;
    border-color: #E5E5E5;
    color: #A0A0A0;
}

QLineEdit, QSpinBox {
    background-color: #FFFFFF;
    border: 1px solid #D1D1D1;
    border-radius: 4px;
    padding: 4px 8px;
    min-height: 20px;
    selection-background-color: #1F6FB2;
    selection-color: #FFFFFF;
}
QLineEdit:focus, QSpinBox:focus { border-bottom: 2px solid #1F6FB2; }
QLineEdit:disabled { color: #A0A0A0; background-color: #F3F3F3; }

QComboBox {
    background-color: #FFFFFF;
    border: 1px solid #D1D1D1;
    border-radius: 4px;
    padding: 4px 8px;
    min-height: 20px;
}
QComboBox:focus { border-bottom: 2px solid #1F6FB2; }
QComboBox:hover { background-color: #FAFAFA; }
QComboBox QAbstractItemView {
    background-color: #FFFFFF;
    border: 1px solid #D1D1D1;
    selection-background-color: #EAEAEA;
    selection-color: #1B1B1B;
    outline: none;
}

QListView, QTreeView, QTableView {
    background-color: #FFFFFF;
    alternate-background-color: #FAFAFA;
    border: 1px solid #E5E5E5;
    border-radius: 4px;
    selection-background-color: #D2E2F0;
    selection-color: #1B1B1B;
    outline: none;
}
QListView::item, QTreeView::item { min-height: 28px; }
QListView::item:hover, QTreeView::item:hover { background-color: #EAEAEA; }
QListView::item:selected, QTreeView::item:selected {
    background-color: #D2E2F0;
    color: #1B1B1B;
}
QHeaderView::section {
    background-color: #F3F3F3;
    border: none;
    border-bottom: 1px solid #E5E5E5;
    padding: 4px 8px;
}

QGroupBox {
    border: 1px solid #E5E5E5;
    border-radius: 8px;
    margin-top: 12px;
    padding-top: 8px;
    background-color: #FFFFFF;
}
QGroupBox::title {
    subcontrol-origin: margin;
    left: 12px;
    padding: 0 4px;
    color: #5F5F5F;
}

/* Install progress: a thin accent bar (DESIGN.md progress bar); the step
 * text is Calamares' own label above it. */
QProgressBar {
    background-color: #E5E5E5;
    border: none;
    border-radius: 3px;
    max-height: 6px;
    min-height: 6px;
    color: transparent;
}
QProgressBar::chunk {
    background-color: #1F6FB2;
    border-radius: 3px;
}

QScrollBar:vertical {
    background: transparent;
    width: 10px;
    margin: 0;
}
QScrollBar::handle:vertical {
    background: #B5B5B5;
    border-radius: 4px;
    min-height: 32px;
    margin: 2px;
}
QScrollBar::handle:vertical:hover { background: #8F8F8F; }
QScrollBar::add-line, QScrollBar::sub-line { height: 0; width: 0; }
QScrollBar::add-page, QScrollBar::sub-page { background: transparent; }

QToolTip {
    background-color: #FFFFFF;
    border: 1px solid #D1D1D1;
    border-radius: 4px;
    color: #1B1B1B;
    padding: 4px;
}
