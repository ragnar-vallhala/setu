# The first-boot wizard on an installed system: labwc on tty1 running
# Calamares as root in OEM mode (setu-firstboot-session, config in
# /etc/calamares). Its last job (setu-firstboot-finish) creates
# /var/lib/setu/firstboot.done, picks the session or a password login for
# tty1 and disables this unit, so it never runs again; when the unit stops,
# setu-firstboot-handoff starts what was picked.
[Unit]
Description=Setu first-boot wizard (labwc + Calamares)
ConditionKernelCommandLine=!boot=live
ConditionPathExists=!/var/lib/setu/firstboot.done
After=systemd-user-sessions.service plymouth-quit-wait.service getty@tty1.service
Conflicts=getty@tty1.service
Before=setu-session.service
Wants=dbus.socket systemd-logind.service
After=dbus.socket systemd-logind.service

[Service]
Type=simple
User=root
PAMName=login
WorkingDirectory=~
TTYPath=/dev/tty1
TTYReset=yes
TTYVHangup=yes
TTYVTDisallocate=yes
StandardInput=tty-fail
StandardOutput=journal+console
StandardError=journal+console
UtmpIdentifier=tty1
UtmpMode=user
Environment=WLR_RENDERER=pixman
Environment=WLR_NO_HARDWARE_CURSORS=1
Environment=XDG_SESSION_TYPE=wayland
Environment=QT_QPA_PLATFORM=wayland
ExecStart=/usr/bin/labwc -S /usr/lib/setu/setu-firstboot-session
ExecStopPost=/usr/lib/setu/setu-firstboot-handoff
# setu-firstboot-session restarts Calamares itself until the wizard has
# finished; when it has, the unit stops and setu-session (After=) starts
Restart=on-failure
RestartSec=2

[Install]
WantedBy=graphical.target
