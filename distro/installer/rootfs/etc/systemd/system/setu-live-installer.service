# The installer on the live system (booted with boot=live): labwc on tty1
# running Calamares as root (setu-installer-session). Same pattern as
# setu-session.service. Inert on an installed system.
[Unit]
Description=Setu installer (labwc + Calamares)
ConditionKernelCommandLine=boot=live
After=systemd-user-sessions.service plymouth-quit-wait.service getty@tty1.service
Conflicts=getty@tty1.service
Wants=dbus.socket systemd-logind.service
After=dbus.socket systemd-logind.service

[Service]
Type=simple
User=root
PAMName=login
WorkingDirectory=~
TTYPath=/dev/tty1
TTYReset=yes
TTYVHangup=yes
TTYVTDisallocate=yes
StandardInput=tty-fail
StandardOutput=journal+console
StandardError=journal+console
UtmpIdentifier=tty1
UtmpMode=user
Environment=WLR_RENDERER=pixman
Environment=WLR_NO_HARDWARE_CURSORS=1
Environment=XDG_SESSION_TYPE=wayland
Environment=QT_QPA_PLATFORM=wayland
ExecStart=/usr/bin/labwc -S /usr/lib/setu/setu-installer-session
Restart=always
RestartSec=3

[Install]
WantedBy=graphical.target
