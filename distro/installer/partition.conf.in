# Calamares partition module: the Setu disk layout. Generated by
# builder/build-rootfs.sh from distro/layout.env (the @...@ values), so the
# installer and the dev image make the same partitions:
# ESP + setu-root (ext4) + setu-c (ext4 with casefold, the rest of the disk).
# Docs: Calamares src/modules/partition/partition.conf (3.3).
---
efi:
    mountPoint:      "/boot/efi"
    recommendedSize: @ESP_SIZE@
    minimumSize:     32MiB
    label:           "@ESP_LABEL@"

# Setu needs its own layout: offer "erase disk" only (no manual
# partitioning, no swap partition, no encryption for now).
userSwapChoices: [ none ]
initialSwapChoice: none
initialPartitioningChoice: erase
allowManualPartitioning: false
enableLuksAutomatedPartitioning: false
defaultPartitionTableType: gpt
requiredPartitionTableType: gpt
defaultFileSystemType: "ext4"
drawNestedPartitions: false
alwaysShowPartitionLabels: true
lvm:
    enable: false

# "name" is the GPT partition name and the file system label. The C:
# volume is made with the casefold feature; the job after mounting
# (shellprocess@cvol, setu-cvol-init) flags its root directory, labels it
# and turns the feature on itself if kpmcore did not.
partitionLayout:
    - name: "@ROOT_NAME@"
      type: "@ROOT_TYPE@"
      filesystem: "ext4"
      mountPoint: "/"
      size: @ROOT_SIZE@
    - name: "@CVOL_NAME@"
      type: "@CVOL_TYPE@"
      filesystem: "ext4"
      mountPoint: "@CVOL_DIR@"
      size: 100%
      features:
        casefold: true
