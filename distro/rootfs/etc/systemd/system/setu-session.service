# Autologin for the `setu` user on tty1: starts the labwc Wayland compositor
# (which runs Xwayland on demand) with setu-session as its session program.
# Same pattern as cage's documented kiosk unit: PAMName opens a logind
# session on seat0, which grants the user access to DRM and input devices.
[Unit]
Description=Setu desktop session (labwc + setu-session)
After=systemd-user-sessions.service plymouth-quit-wait.service getty@tty1.service
Conflicts=getty@tty1.service
Wants=dbus.socket systemd-logind.service
After=dbus.socket systemd-logind.service

[Service]
Type=simple
User=setu
PAMName=login
WorkingDirectory=~
TTYPath=/dev/tty1
TTYReset=yes
TTYVHangup=yes
TTYVTDisallocate=yes
StandardInput=tty-fail
StandardOutput=journal+console
StandardError=journal+console
UtmpIdentifier=tty1
UtmpMode=user
# QEMU's virtio-gpu has no 3D here: use wlroots' software renderer.
Environment=WLR_RENDERER=pixman
Environment=WLR_NO_HARDWARE_CURSORS=1
Environment=XDG_SESSION_TYPE=wayland
# labwc's theme, fonts and cursor from the active theme pack, before it starts
ExecStartPre=-/usr/local/bin/setu-session --labwc
ExecStart=/usr/bin/labwc -S /usr/local/bin/setu-session
Restart=always
RestartSec=3

[Install]
WantedBy=graphical.target
