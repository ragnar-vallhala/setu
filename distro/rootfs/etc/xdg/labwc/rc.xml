<?xml version="1.0"?>
<!--
  labwc configuration for the Setu session. labwc only hosts the personality's
  desktop window (fullscreen, see setu-session); the Setu shell is the
  desktop UI. So: no server-side decorations, and no compositor key bindings
  (labwc's defaults, e.g. Alt+F4 or Super for its menu, would act on the whole
  desktop window instead of reaching Windows programs). Defining one keybind
  replaces labwc's default set.
  Theme: labwc's built-in one with Setu's colours (themerc-override), Inter
  and 8 px corners (docs/DESIGN.md); cursors: environment.
-->
<labwc_config>
  <core>
    <decoration>client</decoration>
    <gap>0</gap>
  </core>
  <theme>
    <cornerRadius>8</cornerRadius>
    <font place="ActiveWindow"><name>Inter</name><size>10</size><weight>bold</weight></font>
    <font place="InactiveWindow"><name>Inter</name><size>10</size><weight>bold</weight></font>
    <font place="MenuHeader"><name>Inter</name><size>10</size><weight>bold</weight></font>
    <font place="MenuItem"><name>Inter</name><size>10</size></font>
    <font place="OnScreenDisplay"><name>Inter</name><size>10</size></font>
  </theme>
  <keyboard>
    <keybind key="W-A-S-F12">
      <action name="None" />
    </keybind>
  </keyboard>
  <windowRules>
    <windowRule identifier="*" serverDecoration="no" />
  </windowRules>
</labwc_config>
