#!/bin/sh
# setu-session: the one entry point for the Setu desktop session.
#
# Runs inside the Wayland compositor (labwc starts it with `-S`, so the
# compositor exits when this script does). It starts the Setu personality
# (wineserver) and then the shell (setu-shell.exe if the image has it, else
# Wine's notepad as a placeholder).
#
# Every Windows program shares one personality desktop, "setu": a single
# fullscreen Xwayland window the size of the display. Inside it the
# personality draws all windows itself, so labwc never decorates, stacks or
# places them, and the shell's taskbar and work area apply to every program.
#
# Overrides (environment):
#   SETU_PERSONALITY  personality install prefix (default /opt/setu/personality,
#                     falls back to Debian's wine in /usr/bin)
#   SETU_SHELL        Windows program to run as the shell
#                     (default /opt/setu/shell/setu-shell.exe, else notepad)
#   WINEPREFIX        default ~/.setu/prefix
#   SETU_RES          desktop size WxH (default: the first connected DRM
#                     output's preferred mode, else 1280x800)
#   SETU_THEME_EXE    the theme tool (default /opt/setu/shell/setu-theme.exe)
#
# setu-session --labwc only writes labwc's config for the active theme pack.

log() { echo "setu-session: $*"; }

# ---- theme ------------------------------------------------------------------
# active_theme: HKCU\Software\Setu\Theme\Current from the prefix's user.reg
# (read before the personality runs), when that pack exists; else setu-light.
active_theme() {
    _id=$(awk '
        /^\[/ { s = tolower($0) ~ /^\[software\\\\setu\\\\theme\]/; next }
        s && tolower($0) ~ /^"current"="/ { v = $0; sub(/^"[^"]*"="/, "", v); sub(/".*/, "", v); print v; exit }
    ' "$WINEPREFIX/user.reg" 2>/dev/null)
    case $_id in ''|*[!a-z0-9-]*) _id=setu-light ;; esac
    [ "$_id" = setu-light ] || /usr/lib/setu/setu-theme-linux find "$_id" >/dev/null 2>&1 || {
        log "theme: $_id not found, using setu-light" >&2; _id=setu-light; }
    echo "$_id"
}

# theme_sync: the system's packs, icons, wallpapers, cursors and sounds on C:
theme_sync() {
    [ -x /usr/lib/setu/setu-theme-sync ] && [ -d "$WINEPREFIX/dosdevices/c:" ] &&
        /usr/lib/setu/setu-theme-sync "$WINEPREFIX/dosdevices/c:/"
}

# theme_linux: labwc's theme, fonts and cursor from the active pack
# (~/.config/labwc), applied at once if they changed.
theme_linux() {
    _out=$(/usr/lib/setu/setu-theme-linux labwc "$THEME" "$HOME/.config/labwc" 2>&1) ||
        log "labwc theme: $_out"
    case $_out in *changed*) [ -n "${LABWC_PID:-}" ] && labwc --reconfigure 2>/dev/null ;; esac
    XCURSOR_THEME=$(/usr/lib/setu/setu-theme-linux get "$THEME" Cursor theme 2>/dev/null)
    XCURSOR_SIZE=$(/usr/lib/setu/setu-theme-linux get "$THEME" Cursor size 2>/dev/null)
    XCURSOR_THEME=${XCURSOR_THEME:-setu-light} XCURSOR_SIZE=${XCURSOR_SIZE:-24}
    log "theme: $THEME (cursor $XCURSOR_THEME $XCURSOR_SIZE)"
}

# theme_cursors_sounds: the .theme file's [Control Panel\Cursors] and
# [AppEvents\Schemes\...] sections into HKCU (setu-theme.exe does not write
# them yet), as a .reg file imported with regedit.
theme_cursors_sounds() {
    _dir=$(/usr/lib/setu/setu-theme-linux find "$THEME" 2>/dev/null) || return 0
    [ -f "$_dir/$THEME.theme" ] || return 0
    _reg=$(mktemp /tmp/setu-theme-XXXXXX.reg) || return 0
    tr -d '\r' < "$_dir/$THEME.theme" | awk '
        BEGIN { print "Windows Registry Editor Version 5.00" }
        /^\[/ {
            sec = substr($0, 2, length($0) - 2); on = 0
            if (sec == "Control Panel\\Cursors" || index(sec, "AppEvents\\Schemes\\Apps\\") == 1) {
                on = 1; print ""
                if (!scheme && index(sec, "AppEvents") == 1) {  # the active scheme: .Current
                    scheme = 1; print "[HKEY_CURRENT_USER\\AppEvents\\Schemes]"; print "@=\".Current\""; print ""
                }
                print "[HKEY_CURRENT_USER\\" sec "]"
            }
            next
        }
        on && /=/ && !/^;/ {
            k = substr($0, 1, index($0, "=") - 1); v = substr($0, index($0, "=") + 1)
            sub(/^%[Ww][Ii][Nn][Dd][Ii][Rr]%/, "C:\\Windows", v)
            gsub(/\\/, "\\\\", v)
            print (k == "DefaultValue" ? "@" : "\"" k "\"") "=\"" v "\""
        }' > "$_reg"
    wine regedit /S "$(winepath -w "$_reg" 2>/dev/null)" >/dev/null 2>&1
    rm -f "$_reg"
}

# theme_fallback: without setu-theme.exe (an image built without the shell),
# the pack's wallpaper and the font smoothing, through wine reg.
theme_fallback() {
    wine reg add 'HKCU\Software\Setu\Theme' /v Current /d "$THEME" /f >/dev/null 2>&1
    wine reg add 'HKCU\Control Panel\Desktop' /v FontSmoothing /t REG_SZ /d 2 /f >/dev/null 2>&1
    wine reg add 'HKCU\Control Panel\Desktop' /v FontSmoothingType /t REG_DWORD /d 2 /f >/dev/null 2>&1
    [ -f "/usr/share/setu/themes/$THEME/wallpaper/wallpaper.bmp" ] || return 0
    _cur=$(wine reg query 'HKCU\Control Panel\Desktop' /v Wallpaper 2>/dev/null \
           | tr -d '\r' | sed -n 's/^ *Wallpaper *REG_SZ *//p')
    case $(echo "$_cur" | tr A-Z a-z) in
        ''|*'\resources\themes\'*)
            wine reg add 'HKCU\Control Panel\Desktop' /v Wallpaper \
                /d "C:\\Windows\\Resources\\Themes\\$THEME\\wallpaper\\wallpaper.bmp" /f >/dev/null 2>&1
            wine reg add 'HKCU\Control Panel\Desktop' /v WallpaperStyle /d 10 /f >/dev/null 2>&1
            wine reg add 'HKCU\Control Panel\Desktop' /v TileWallpaper /d 0 /f >/dev/null 2>&1 ;;
    esac
    log "theme: applied without setu-theme.exe (wallpaper and font smoothing only)"
}

SETU_PERSONALITY=${SETU_PERSONALITY:-/opt/setu/personality}
if [ -x "$SETU_PERSONALITY/bin/wine" ]; then
    PATH="$SETU_PERSONALITY/bin:$PATH"
    log "personality: $SETU_PERSONALITY ($(sed -n 's/^version=//p' "$SETU_PERSONALITY/SETU_BUILD" 2>/dev/null))"
else
    log "personality: Debian wine ($(command -v wine))"
fi
export PATH
export WINEPREFIX="${WINEPREFIX:-$HOME/.setu/prefix}"
export WINEDEBUG="${WINEDEBUG:--all}"
export WINEDLLOVERRIDES="${WINEDLLOVERRIDES:-mshtml=}"  # no Gecko prompt (Wine Mono is bundled)
mkdir -p "$(dirname "$WINEPREFIX")"

# Theme packs: the user's own (%LOCALAPPDATA%\Setu\Themes), then the system's.
export SETU_THEME_PATH="$WINEPREFIX/dosdevices/c:/users/$(id -un)/AppData/Local/Setu/Themes:/usr/share/setu/themes"
THEME=$(active_theme)
# --labwc: only write labwc's config for the active pack (setu-session.service
# runs this before labwc starts, so its theme and cursor are right from the
# first frame).
if [ "${1:-}" = --labwc ]; then
    theme_linux
    exit 0
fi

log "WAYLAND_DISPLAY=$WAYLAND_DISPLAY DISPLAY=$DISPLAY WINEPREFIX=$WINEPREFIX"

# Start the personality: make sure the prefix (the C: drive and registry)
# exists, then keep a wineserver running for the whole session. The image
# build pre-creates the prefix for the setu user, so this is quick.
# A new prefix gets the system volume as its C: (the image build does this
# for the setu user), when this user may write to it.
SETU_CDRIVE=/var/lib/setu/volumes/c
if [ ! -d "$WINEPREFIX/dosdevices" ] && [ -w "$SETU_CDRIVE" ]; then
    mkdir -p "$WINEPREFIX/dosdevices"
    ln -s "$SETU_CDRIVE" "$WINEPREFIX/dosdevices/c:"
    ln -s / "$WINEPREFIX/dosdevices/z:"
fi
if [ ! -f "$WINEPREFIX/system.reg" ]; then
    log "creating prefix"
    wineboot -i
fi
wineserver -p
log "personality up"

# One desktop for the whole session, sized to the display. When the size
# matches the output, the personality makes the desktop window fullscreen.
if [ -z "$SETU_RES" ]; then
    for c in /sys/class/drm/card*-*; do
        [ "$(cat "$c/status" 2>/dev/null)" = connected ] || continue
        SETU_RES=$(head -n1 "$c/modes" 2>/dev/null)
        [ -n "$SETU_RES" ] && break
    done
fi
SETU_RES=${SETU_RES:-1280x800}

# The active theme pack (docs/THEMES.md): its colours, fonts, wallpaper,
# cursors, sounds and icons for Windows programs (setu-theme apply --login),
# and the same look for labwc and the boot splash.
theme_sync
theme_linux
export XCURSOR_THEME XCURSOR_SIZE
SETU_THEME_EXE=${SETU_THEME_EXE:-/opt/setu/shell/setu-theme.exe}
if [ -f "$SETU_THEME_EXE" ]; then
    wine "$SETU_THEME_EXE" apply --login "$THEME"
    rc=$?
    log "setu-theme apply --login $THEME: exit $rc"
    if [ "$rc" = 2 ] && [ "$THEME" != setu-light ]; then
        THEME=setu-light
        wine "$SETU_THEME_EXE" apply --login "$THEME"
        theme_linux
    fi
else
    theme_fallback
fi
theme_cursors_sounds
# The boot splash follows the active pack. It lives in the initramfs, which
# setu-boot-theme rebuilds only when the pack changed (in the background:
# the next boot shows it).
if [ -f "/usr/share/plymouth/themes/$THEME/$THEME.plymouth" ] && [ -x /usr/lib/setu/setu-boot-theme ]; then
    (sudo -n /usr/lib/setu/setu-boot-theme "$THEME" 2>&1 | sed 's/^/setu-session: /') &
fi

log "desktop: setu $SETU_RES"
wine reg add 'HKCU\Software\Wine\Explorer' /v Desktop /d setu /f >/dev/null 2>&1
wine reg add 'HKCU\Software\Wine\Explorer\Desktops' /v setu /d "$SETU_RES" /f >/dev/null 2>&1

# Drive letters D: and up follow the system table (services/fs).
SYNC_PID=
if [ -x /usr/local/bin/setu-drives-sync ] && [ -d /run/setu/dosdevices ]; then
    /usr/local/bin/setu-drives-sync &
    SYNC_PID=$!
fi

SETU_SHELL=${SETU_SHELL:-/opt/setu/shell/setu-shell.exe}
if [ -f "$SETU_SHELL" ]; then
    SHELL_CMD=$SETU_SHELL
else
    log "shell: notepad (placeholder; $SETU_SHELL not found)"
    SHELL_CMD=notepad
fi

# A shell that exits with 0 ends the session. One that fails (a crash) is
# started again, so the programs still open on the desktop survive; more
# than 5 failures within 2 minutes end the session instead of looping.
fails=0
window_start=$(date +%s)
while :; do
    log "starting shell: $SHELL_CMD"
    wine "$SHELL_CMD"
    rc=$?
    log "shell exited ($rc)"
    [ "$rc" = 0 ] && break
    now=$(date +%s)
    if [ $((now - window_start)) -gt 120 ]; then
        fails=0
        window_start=$now
    fi
    fails=$((fails + 1))
    if [ "$fails" -gt 5 ]; then
        log "shell failed $fails times in 2 minutes; ending the session"
        break
    fi
    sleep 1
done
[ -n "$SYNC_PID" ] && kill "$SYNC_PID" 2>/dev/null
wineserver -k
exit $rc
