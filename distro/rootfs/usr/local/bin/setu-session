#!/bin/sh
# setu-session: the one entry point for the Setu desktop session.
#
# Runs inside the Wayland compositor (labwc starts it with `-S`, so the
# compositor exits when this script does). It starts the Setu personality
# (wineserver) and then the shell (setu-shell.exe if the image has it, else
# Wine's notepad as a placeholder).
#
# Every Windows program shares one personality desktop, "setu": a single
# fullscreen Xwayland window the size of the display. Inside it the
# personality draws all windows itself, so labwc never decorates, stacks or
# places them, and the shell's taskbar and work area apply to every program.
#
# Overrides (environment):
#   SETU_PERSONALITY  personality install prefix (default /opt/setu/personality,
#                     falls back to Debian's wine in /usr/bin)
#   SETU_SHELL        Windows program to run as the shell
#                     (default /opt/setu/shell/setu-shell.exe, else notepad)
#   WINEPREFIX        default ~/.setu/prefix
#   SETU_RES          desktop size WxH (default: the first connected DRM
#                     output's preferred mode, else 1280x800)

log() { echo "setu-session: $*"; }

SETU_PERSONALITY=${SETU_PERSONALITY:-/opt/setu/personality}
if [ -x "$SETU_PERSONALITY/bin/wine" ]; then
    PATH="$SETU_PERSONALITY/bin:$PATH"
    log "personality: $SETU_PERSONALITY ($(sed -n 's/^version=//p' "$SETU_PERSONALITY/SETU_BUILD" 2>/dev/null))"
else
    log "personality: Debian wine ($(command -v wine))"
fi
export PATH
export WINEPREFIX="${WINEPREFIX:-$HOME/.setu/prefix}"
export WINEDEBUG="${WINEDEBUG:--all}"
export WINEDLLOVERRIDES="${WINEDLLOVERRIDES:-mshtml=}"  # no Gecko prompt (Wine Mono is bundled)
mkdir -p "$(dirname "$WINEPREFIX")"

log "WAYLAND_DISPLAY=$WAYLAND_DISPLAY DISPLAY=$DISPLAY WINEPREFIX=$WINEPREFIX"

# Start the personality: make sure the prefix (the C: drive and registry)
# exists, then keep a wineserver running for the whole session. The image
# build pre-creates the prefix for the setu user, so this is quick.
# A new prefix gets the system volume as its C: (the image build does this
# for the setu user), when this user may write to it.
SETU_CDRIVE=/var/lib/setu/volumes/c
if [ ! -d "$WINEPREFIX/dosdevices" ] && [ -w "$SETU_CDRIVE" ]; then
    mkdir -p "$WINEPREFIX/dosdevices"
    ln -s "$SETU_CDRIVE" "$WINEPREFIX/dosdevices/c:"
    ln -s / "$WINEPREFIX/dosdevices/z:"
fi
if [ ! -f "$WINEPREFIX/system.reg" ]; then
    log "creating prefix"
    wineboot -i
fi
wineserver -p
log "personality up"

# One desktop for the whole session, sized to the display. When the size
# matches the output, the personality makes the desktop window fullscreen.
if [ -z "$SETU_RES" ]; then
    for c in /sys/class/drm/card*-*; do
        [ "$(cat "$c/status" 2>/dev/null)" = connected ] || continue
        SETU_RES=$(head -n1 "$c/modes" 2>/dev/null)
        [ -n "$SETU_RES" ] && break
    done
fi
SETU_RES=${SETU_RES:-1280x800}

# Setu's look (docs/DESIGN.md) for this prefix, set before the first program
# opens the desktop (the desktop reads its wallpaper when it starts).
# Font smoothing: on, reported as ClearType (FontSmoothing=2,
# FontSmoothingType=2: what Windows reports by default), drawn in grayscale
# (no FontSmoothingOrientation: the personality then antialiases ClearType
# text in grayscale; Xwayland draws in software, often scaled in a VM window,
# where colour fringes look worse). SETU_FONT_SMOOTHING=rgb draws subpixel
# RGB instead. Set once per prefix; programs may change them afterwards.
look=$WINEPREFIX/.setu-look-1
if [ ! -f "$look" ]; then
    wine reg add 'HKCU\Control Panel\Desktop' /v FontSmoothing /t REG_SZ /d 2 /f >/dev/null 2>&1
    wine reg add 'HKCU\Control Panel\Desktop' /v FontSmoothingType /t REG_DWORD /d 2 /f >/dev/null 2>&1
    if [ "$SETU_FONT_SMOOTHING" = rgb ]; then
        wine reg add 'HKCU\Control Panel\Desktop' /v FontSmoothingOrientation /t REG_DWORD /d 1 /f >/dev/null 2>&1
    fi
    : > "$look"
fi
# Wallpaper: Setu's (distro/artwork/wallpaper.py), drawn at common display
# sizes. The desktop shows a .bmp centred and unscaled, so pick the one the
# size of the display, else the smallest that covers it (its top left shows).
# Only while the wallpaper is Setu's or unset: one a program or the user
# chose stays.
wallpaper_for() { # WxH
    _dir=/usr/share/setu/wallpapers
    [ -f "$_dir/setu-$1.bmp" ] && { echo "$_dir/setu-$1.bmp"; return; }
    _w=${1%x*} _h=${1#*x} _best= _area=
    for _f in "$_dir"/setu-*x*.bmp; do
        [ -f "$_f" ] || continue
        _s=${_f##*/setu-}; _s=${_s%.bmp}
        [ "${_s%x*}" -ge "$_w" ] && [ "${_s#*x}" -ge "$_h" ] || continue
        _a=$(( ${_s%x*} * ${_s#*x} ))
        if [ -z "$_area" ] || [ "$_a" -lt "$_area" ]; then _best=$_f _area=$_a; fi
    done
    [ -n "$_best" ] || _best=$(ls "$_dir"/setu-*x*.bmp 2>/dev/null | tail -n1)
    echo "$_best"
}
wp=$(wallpaper_for "$SETU_RES")
if [ -n "$wp" ]; then
    cur=$(wine reg query 'HKCU\Control Panel\Desktop' /v Wallpaper 2>/dev/null \
          | tr -d '\r' | sed -n 's/^ *Wallpaper *REG_SZ *//p')
    case $cur in
        ''|*'\usr\share\setu\wallpapers\'*)
            winwp="Z:$(echo "$wp" | tr / '\\')"
            if [ "$cur" != "$winwp" ]; then
                wine reg add 'HKCU\Control Panel\Desktop' /v Wallpaper /d "$winwp" /f >/dev/null 2>&1
            fi
            log "wallpaper: $wp" ;;
        *) log "wallpaper: $cur (chosen in Windows)" ;;
    esac
fi

log "desktop: setu $SETU_RES"
wine reg add 'HKCU\Software\Wine\Explorer' /v Desktop /d setu /f >/dev/null 2>&1
wine reg add 'HKCU\Software\Wine\Explorer\Desktops' /v setu /d "$SETU_RES" /f >/dev/null 2>&1

# Drive letters D: and up follow the system table (services/fs).
SYNC_PID=
if [ -x /usr/local/bin/setu-drives-sync ] && [ -d /run/setu/dosdevices ]; then
    /usr/local/bin/setu-drives-sync &
    SYNC_PID=$!
fi

SETU_SHELL=${SETU_SHELL:-/opt/setu/shell/setu-shell.exe}
if [ -f "$SETU_SHELL" ]; then
    SHELL_CMD=$SETU_SHELL
else
    log "shell: notepad (placeholder; $SETU_SHELL not found)"
    SHELL_CMD=notepad
fi

# A shell that exits with 0 ends the session. One that fails (a crash) is
# started again, so the programs still open on the desktop survive; more
# than 5 failures within 2 minutes end the session instead of looping.
fails=0
window_start=$(date +%s)
while :; do
    log "starting shell: $SHELL_CMD"
    wine "$SHELL_CMD"
    rc=$?
    log "shell exited ($rc)"
    [ "$rc" = 0 ] && break
    now=$(date +%s)
    if [ $((now - window_start)) -gt 120 ]; then
        fails=0
        window_start=$now
    fi
    fails=$((fails + 1))
    if [ "$fails" -gt 5 ]; then
        log "shell failed $fails times in 2 minutes; ending the session"
        break
    fi
    sleep 1
done
[ -n "$SYNC_PID" ] && kill "$SYNC_PID" 2>/dev/null
wineserver -k
exit $rc
