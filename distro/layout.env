# The Setu disk layout: the one place that names its partitions and sizes.
# Shell syntax. Sourced by builder/build-rootfs.sh, which partitions the dev
# image with it and, for the installer ISO, turns it into Calamares'
# partition.conf (installer/partition.conf.in). GPT, in this order:
#   1. the EFI system partition
#   2. the Linux root file system (plain ext4)
#   3. the system volume behind C: (ext4 with casefold, the rest of the disk;
#      services/fs/README.md)
SETU_ESP_SIZE=256MiB
SETU_ESP_NAME=ESP
SETU_ESP_LABEL=SETU-ESP
SETU_ROOT_SIZE=6GiB
SETU_ROOT_NAME=setu-root
SETU_ROOT_LABEL=setu-root
# "Linux root (x86-64)" from the Discoverable Partitions Specification
SETU_ROOT_TYPE=4f68bce3-e8cd-4db1-96e7-fbcaf984b709
SETU_CVOL_NAME=setu-c
SETU_CVOL_LABEL=SETU-C
# "Linux filesystem data"
SETU_CVOL_TYPE=0fc63daf-8483-4772-8e79-3d69d8477de4
SETU_CVOL_DIR=/var/lib/setu/volumes/c
