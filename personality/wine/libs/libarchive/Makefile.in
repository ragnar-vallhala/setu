EXTRAINCL = $(ARCHIVE_PE_CFLAGS) $(ZLIB_PE_CFLAGS) $(BZIP2_PE_CFLAGS) $(LZMA_PE_CFLAGS) $(ZSTD_PE_CFLAGS)
EXTRADEFS = -DHAVE_CONFIG_H

